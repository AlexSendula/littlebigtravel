{
  "name": "littlebigtravel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js \"features/**/*.feature\" --import \"tests/bdd/**/*.ts\" --format progress --tags \"not @todo\"",
    "test:visual": "playwright test --config playwright.config.ts tests/visual",
    "test:visual:update": "playwright test --config playwright.config.ts tests/visual --update-snapshots",
    "test:perf": "playwright test --config playwright.performance.config.ts tests/performance",
    "test:all": "npm run test:unit && npm run test:bdd && npm run test:visual"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@playwright/test": "^1.59.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
